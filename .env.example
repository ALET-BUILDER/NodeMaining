# ─────────────────────────────────────────────
# NodeMaster — Environment Variables Template
# ─────────────────────────────────────────────
# Salin file ini jadi .env untuk lokal.
# Di Railway: isi langsung di Settings > Variables.
# JANGAN commit .env ke GitHub!
# ─────────────────────────────────────────────

# Port server (Railway isi otomatis, jangan diubah)
PORT=3000

# ⚠️ WAJIB diubah sebelum deploy ke produksi!
# PIN untuk login ke admin panel
ADMIN_PIN=043011

# Secret key untuk JWT admin session
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ganti_dengan_random_string_panjang_minimal_32_karakter

# Domain utama (untuk CORS whitelist, opsional)
# DOMAIN=https://namadomain.railway.app

# Path database SQLite
# Di Railway dengan volume: /data/nodemaster.db
# Lokal: biarkan kosong (auto ./nodemaster.db)
# DB_PATH=/data/nodemaster.db

# Node environment
NODE_ENV=production
